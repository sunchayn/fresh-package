{
    "private": true,
    "type": "module",
    "scripts": {
        "lint": "eslint --config tools/eslint/.eslintrc.cjs --ignore-path tools/eslint/.eslintignore resources/js --ext .ts,.vue",
        "prettier": "prettier --config tools/prettier/.prettierrc.json --ignore-path tools/prettier/.prettierignore resources/js",
        "style:check": "npm run lint && npm run prettier -- --check .",
        "style:fix": "npm run lint -- --fix && npm run prettier -- --write .",
        "type:check": "vue-tsc --noEmit --project tsconfig.json",
        "vite": "vite --config vite.config.js",
        "build": "npm run type:check && npm run vite -- build",
        "build:dev": "npm run vite -- build --mode=development",
        "dev": "npm run vite -- dev",
        "test": "vitest --config resources/js/tests/vitest.config.ts",
        "test:run": "npm run test -- run"
    },
    "devDependencies": {
        "@rushstack/eslint-patch": "^1.16.1",
        "@tailwindcss/vite": "^4.3.3",
        "@types/node": "^26.5.1",
        "@typescript-eslint/eslint-plugin": "^8.70.0",
        "@typescript-eslint/parser": "^8.70.0",
        "@vitejs/plugin-vue": "^6.0.8",
        "@vitest/coverage-v8": "^5.0.0",
        "@vue/eslint-config-prettier": "^10.2.0",
        "@vue/eslint-config-typescript": "^14.9.0",
        "@vue/test-utils": "^2.5.0",
        "eslint": "^10.10.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.6",
        "eslint-plugin-vue": "^10.11.0",
        "jsdom": "^30.0.1",
        "laravel-vite-plugin": "^3.2.0",
        "prettier": "^3.9.6",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "tailwindcss": "^4.3.3",
        "typescript": "^7.0.2",
        "vite": "^8.3.0",
        "vitest": "^5.0.0",
        "vue": "^3.5.42",
        "vue-eslint-parser": "^10.4.1",
        "vue-tsc": "^3.3.11"
    },
    "dependencies": {
        "axios": "^1.20.0",
        "pinia": "^4.0.3",
        "vue-router": "^5.3.1"
    }
}
